# ── Gemini AI ──
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Set to true to run with mock AI responses (no API key needed)
GEMINI_MOCK=false

# ── Auth ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Email(s) that will have admin access (comma-separated). Register with this email to become admin.
ADMIN_EMAILS=admin@example.com

# ── PostgreSQL ──
POSTGRES_USER=smarterp
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=smarterp_db

# ── Database URLs ──
# Keep host as "postgres" (the docker-compose service name). Update user/password/db to match the values above.
DATABASE_URL=postgresql+asyncpg://smarterp:change-this-password@postgres:5432/smarterp_db
SYNC_DATABASE_URL=postgresql+psycopg2://smarterp:change-this-password@postgres:5432/smarterp_db
